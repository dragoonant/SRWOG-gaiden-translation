  },
  {
   "id": 269,
   "jp": "「……何でもない」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 270,
   "jp": "「ねえ、医務室へ行ったら？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 271,
   "jp": "「大丈夫だ。で、話とは何だ？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 272,
   "jp": "「あなた、レーツェルさんと話してた時、@　ツェントル・プロジェクトのトーチカ１に@　いたことがあるって言ってたわね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 273,
   "jp": "「ああ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 274,
   "jp": "「それって、どこにあるの？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 275,
   "jp": "「何故、そんなことを聞く？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 276,
   "jp": "「私、ハワイのトーチカにしか行ったことないし……@　トーチカ１の場所は機密事項だって言われて、@　どこにあるか教えてもらってないの」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 277,
   "jp": "「俺もトーチカ１の所在地は知らん」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 278,
   "jp": "「え？　だって、そこにいたことがあるって……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 279,
   "jp": "「それは昔のトーチカ１だ。@　事故が起きたせいで、今は廃棄されているがな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 280,
   "jp": "「事故……？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 281,
   "jp": "「イェッツトに破壊されたのさ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 282,
   "jp": "「！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 283,
   "jp": "「当時、ツェントル・プロジェクトの連中は@　奴を飼い慣らせず、暴走させてしまった」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 284,
   "jp": "「その後、クライウルブズ達に追撃命令が出たが……@　結果はお前も知っての通りだ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 285,
   "jp": "（生き残ったのはアルベロ・エスト少佐と@　ヒューゴだけ……その後、イェッツトは@　カイ少佐達が倒した……）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 286,
   "jp": "「……前にも聞いたけど、@　ツェントル・プロジェクトは@　何のためにイェッツトを……？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 287,
   "jp": "「兵器として応用するつもりだったようだが、@　詳しくは知らん」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 288,
   "jp": "「まさか、プロジェクトでは@　今もイェッツトの研究を……？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 289,
   "jp": "「……かも知れんな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 290,
   "jp": "「ね、ねえ……@　私達は正しいことをやってるのよね……？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 291,
   "jp": "「正しいこと？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 292,
   "jp": "「<アインスト>や<インスペクター>みたいな敵から@　地球を守る……ツェントル・プロジェクトも@　そのために……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 293,
   "jp": "「ミタールもそんなことを言っていたが、@　建前だろうな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 294,
   "jp": "「建前って……じゃあ、あなたは？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 295,
   "jp": "「………」",
   "en": "...",
   "kind": "text",
   "keep": false
  },
  {
   "id": 296,
   "jp": "（俺は……復讐だ）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 297,
   "jp": "クロガネ　格納庫",
   "en": "",
   "kind": "name",
   "keep": false
  },
  {
   "id": 298,
   "jp": "「あそこのハンガーにあるのは……@　アクセル隊長のソウルゲインですね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 299,
   "jp": "「ああ。彼が消えた後、我々が回収したのだ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 300,
   "jp": "「あの事件の報告書は読んだ。@　コウタとアクセル・アルマーが正体不明の敵と戦い、@　次元の扉に吸い込まれたのだな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 301,
   "jp": "「ええ。キョウスケ中尉とリュウセイ少尉、鋼龍戦隊、@　シャイン王女、そして、ゼンガー達の消失も@　あれと何らかの関係があると考えていますが……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 302,
   "jp": "「個々別々に理由が存在しているのかも知れんぞ。@　異なる世界の扉を開ける方法は、@　一つだけではないのだからな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 303,
   "jp": "「確かに」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 304,
   "jp": "「ラ・ギアスから来たマサキは別として、@　シャドウミラーやアインスト、修羅、@　そして一連の消失事件……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 305,
   "jp": "「時が経つにつれ、境界の変事が頻発し……@　特にここ最近はその間隔が狭まって@　きているように感じる」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 306,
   "jp": "「これは何か大きな異変の前触れではないのか。@　そんな気がする……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 307,
   "jp": "「わあ、あの雲に島……いかにも南の海って感じ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 308,
   "jp": "「輸送機に乗ってる時もそうだったけど、@　景色を見るのが好きなのね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 309,
   "jp": "「うん、珍しくて。@　私、子供の頃からずっと南極にいたから」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 310,
   "jp": "「え？　そうなの？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 311,
   "jp": "「じゃあ、南極の外に出たのは……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 312,
   "jp": "「今回がすっごく久しぶり」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 313,
   "jp": "「ずっと氷の世界に閉じこもってたのか。@　おれだったら、耐えられねえ……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 314,
   "jp": "「でも、退屈はしなかったよ。@　お父さんやお兄ちゃんが一緒だったし……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 315,
   "jp": "「リ・テクには変わった人が多いけど、@　優しくしてくれたし。あと、お父さん達の@　研究を手伝ったりしていたの」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 316,
   "jp": "「研究……遺跡関連の？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 317,
   "jp": "「ええ、お兄ちゃんのエール・シュヴァリアーに@　搭載されてるシュンパティア……あれのテストをね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 318,
   "jp": "「シュンパティア？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 319,
   "jp": "「エール・シュヴァリアーの@　マン・マシーン・インターフェース……@　パイロットの脳波とリンクするらしいの」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 320,
   "jp": "「じゃあ、<Ｔ‐ＬＩＮＫシステム>みたいなものか？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 321,
   "jp": "「概念は近いけど、念動力のような特殊能力は@　必要ないって……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 322,
   "jp": "「でも……どうして、リムが@　シュンパティアのテストを……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 323,
   "jp": "「それは、私が一番最初にあれを動かしたから……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 324,
   "jp": "「……！」",
   "en": "...!",
   "kind": "text",
   "keep": false
  },
  {
   "id": 325,
   "jp": "（ジョッシュさんが言ってたように、@　リムも実験台にされてたってこと……？）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 326,
   "jp": "「へえ、凄いんだな。@　じゃあ、リムもエール・シュヴァリアーを@　操縦できるのか？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 327,
   "jp": "「あれはお兄ちゃんにしか動かせないけど、@　私も訓練を受けてたから……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 328,
   "jp": "（駄目よ、クリス。喋り過ぎ）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 329,
   "jp": "「ご、ごめん……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 330,
   "jp": "「ごめんって？　どうして、謝るの？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 331,
   "jp": "「あ、何でもない、何でもないのよ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 332,
   "jp": "「何だ！？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 333,
   "jp": "クロガネ　ブリッジ",
   "en": "",
   "kind": "name",
   "keep": false
  },
  {
   "id": 334,
   "jp": "「レーツェル様、@　こちらへ高速飛行物体が接近中です」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 335,
   "jp": "「警告を発して来たか？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 336,
   "jp": "「いえ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 337,
   "jp": "「ならば、連邦軍ではないか……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 338,
   "jp": "「もしや、インスペクターでしょうか？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 339,
   "jp": "「彼らが頭上からこちらを見ているとすれば、@　もっと近い所に手勢を転移させてくる」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 340,
   "jp": "「警告を出し、@　それでも接近してくるようであれば、攻撃せよ。@　我らは機乗して、待機する」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 341,
   "jp": "「了解しました」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 342,
   "jp": "「レーツェル様、目標群が警告を無視し、@　レンジ３へ侵入しました」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 343,
   "jp": "「了解した。各機、直ちに出撃を！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 344,
   "jp": "「奴らの機体……@　伊豆で俺達を襲った連中と同じだな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 345,
   "jp": "「こんな所にも現れるなんて……@　結構、行動範囲が広いのね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 346,
   "jp": "「フッ、我らは運がいい。地上へ戻って来て@　すぐにクロガネと相見えるとはな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 347,
   "jp": "所属不明兵",
   "en": "",
   "kind": "name",
   "keep": false
  },
  {
   "id": 348,
   "jp": "「隊長、回収艦から連絡が来ました。@　合流ポイントの変更を要請して来ています」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 349,
   "jp": "「了解した。我々で彼らの目を引き付け、@　その間に別働隊と回収艦を接触させる。@　こちらの迎えの準備を忘れるなと伝えろ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 350,
   "jp": "「はっ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 351,
   "jp": "「目の前の連中は、ボーナスだ。@　上手くやれば、データにさらなる箔が付く」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 352,
   "jp": "「機体のことは、もう気にしなくていい。@　連邦でも解析は進んでいるだろうからな。@　……稼げよ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 353,
   "jp": "「もちろん、そのつもりです」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 354,
   "jp": "（フッ……欲に目がくらんだ連中は、盾になる）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 355,
   "jp": "（……あの中にアイビスはいないようだな）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 356,
   "jp": "「あの戦闘機、カリオンに似てる……!」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 357,
   "jp": "「緋色の機体……もしかして」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 358,
   "jp": "「シリーズ７７、ベガリオン……@　あれが作られていたとは……！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 359,
   "jp": "「レーツェル・ファインシュメッカーだ。@　その機体に乗っているのは、スレイ・プレスティ……@　君なのか？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 360,
   "jp": "「なるほど、顔見知りだったな。@　どうする？　ここは私に任せて、後退するかね？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 361,
   "jp": "「相手が何者であろうと、交戦データを収集する……@　それがスポンサーの要求だ。@　任務の遂行に私の個人的事情など、関係ない」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 362,
   "jp": "「よかろう、プロフェッショナルだ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 363,
   "jp": "（アイビスをアルテリオンから引きずり降ろし、@　私が兄様のプロジェクトＴＤを完遂させる……）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 364,
   "jp": "（そのためには、イスルギ重工だろうと何だろうと@　利用するまで……！）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 365,
   "jp": "「……ねえ、ゼオラ。@　あの緋色の機体のパイロット、@　知り合いなの？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 366,
   "jp": "「正確に言えば、知り合いの知り合いですけど。@　でも、レーツェルさんは……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 367,
   "jp": "「……応答なしか」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 368,
   "jp": "「レーツェル、単機ならともかく、@　あれだけの敵機がいる以上……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 369,
   "jp": "「わかっています。迎撃しましょう」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 370,
   "jp": "「こいつ、他の機体と動きが違うな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 371,
   "jp": "「特殊戦技教導隊の隊長機か。@　いい交戦データを得られそうだな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 372,
   "jp": "「初見の機体だ……お手並み拝見といこうか」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 373,
   "jp": "「そう簡単にデータが取れると思うなよ！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 374,
   "jp": "「ふふふ、私は運がいい。@　何機もの新型機と巡り会えるとはな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 375,
   "jp": "「データ取得はお互い様かも知れないが……@　命まで渡すつもりはない！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 376,
   "jp": "（レーツェル・ファインシュメッカー……@　あなたであっても容赦はしない！）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 377,
