   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 276,
   "jp": "ユン",
   "en": "",
   "kind": "name",
   "keep": false
  },
  {
   "id": 277,
   "jp": "「あと１０分ほどで所定位置に着きます」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 278,
   "jp": "「では、ハガネへ通達。@　エクサランス・レスキューが演習海域外へ@　退去した後、第２次演習を開始します」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 279,
   "jp": "「了解。通達します」",
   "en": "",
   "kind": "text",
   "keep": false
  },
