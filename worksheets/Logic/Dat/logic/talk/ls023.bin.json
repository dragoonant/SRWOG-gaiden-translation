   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 280,
   "jp": "「ほう、アルトアイゼン・リーゼに@　ヴァルシオーネか」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 281,
   "jp": "「あのガーリオン……@　確か、<ノイエＤＣ>残党に雇われてた傭兵だったね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 282,
   "jp": "「こんな所で出くわすとは……腐れ縁だな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 283,
   "jp": "「奴らまで来ているとなれば……@　フン、もうしばしこの異界にいるのも一興か」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 284,
   "jp": "「ヤンロン！　何しに来たのよ！？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 285,
   "jp": "「君達を助けに来たんだ。応援を連れてな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 286,
   "jp": "「応援……？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 287,
   "jp": "「ゲンナジー・Ｉ・コズイレフだ。@　こいつは<魔装機>ジャオーム。よろしく頼む」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 288,
   "jp": "「誰も助けてくれなんて言ってないよ！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 289,
   "jp": "「やれやれ、さっきのことを根に持っているな？@　何も僕は彼らを助けることに反対したわけじゃない」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 290,
   "jp": "「彼を知りて己を知れば、百戦して危うからず……@　敵の情報を得ぬまま戦いに出るという@　軽率な行動を戒めただけだ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 291,
   "jp": "「わかった、わかったよ！@　お説教なら、後でたっぷり聞いてやるから！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 292,
   "jp": "「……雇い主は逃げたか。@　ならば、この勝負、預けておくぞ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 293,
   "jp": "「……よし、追っ手は片付いたか。@　礼を言うぜ、キョウスケ、リューネ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 294,
   "jp": "「タイミングが良かったよ。@　でも、何であいつらに追われてたの？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 295,
   "jp": "「こっちも聞きてえことが色々ある。@　情報交換といこうぜ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 296,
   "jp": "「わかったよ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 297,
   "jp": "「……演習中に召喚されたのなら、@　ヒリュウ改やハガネもこっちへ来てると@　思った方がいいね……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 298,
   "jp": "「俺やカチーナ中尉とラッセルは@　同じ所へ出て来たんだが、レオナや他のみんなは@　別の所へ跳ばされたみてえでな……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 299,
   "jp": "「で、仲間を捜してる途中で@　あのスットコドッコイ軍に出会ったわけよ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 300,
   "jp": "「シュテドニアス軍ですよ、中尉」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 301,
   "jp": "「おう、それそれ。@　奴らはあたしらを保護するとか言い出して、@　協力を要請して来たんだが……」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 302,
   "jp": "「連中の中にあの武者ガーリオンがいてな。@　それで胡散臭いと思って断ったら、@　いきなり襲い掛かって来やがった」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 303,
   "jp": "「味方にならねば、敵に回る……@　早い内に片づけておこうと考えたか」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 304,
   "jp": "「何にせよ、おめえらと会えて良かったぜ。@　キョウスケも無事だってわかったしな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 305,
   "jp": "「エクセ姐さん達、かなり心配してたッスよ」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 306,
   "jp": "「……そうだろうな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 307,
   "jp": "「あの……自分達はまだラ・ギアスのことを@　よくわかっていないんです。よろしければ、@　詳しく説明してもらえませんか」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 308,
   "jp": "「わかった。@　ダンク市に宿がある。そこで一息入れ、@　今後のことについても相談しよう」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 309,
   "jp": "「それでいいか、ゲンナジー？」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 310,
   "jp": "「い、いたのか、あんた。@　……影薄いな」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 311,
   "jp": "「………」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 312,
   "jp": "（何となく親近感を感じるなぁ……）",
   "en": "",
   "kind": "text",
   "keep": false
  }
 ]
}