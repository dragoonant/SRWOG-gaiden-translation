   "kind": "text",
   "keep": false
  },
  {
   "id": 413,
   "jp": "「ええい！　何なんだ、あいつは！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 414,
   "jp": "「撃て、撃て！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 415,
   "jp": "「ヘッ、そんなもんが当たるかってんでぇ！@　怪我したくなかったら、すっこんでろい！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 416,
   "jp": "「ええい、奴を止めろ！」",
