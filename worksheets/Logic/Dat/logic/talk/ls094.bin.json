   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 409,
   "jp": "「それだけじゃないでしょう！」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 410,
   "jp": "（そういう所は鋭いわね）",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 411,
   "jp": "「一つだけ真実を教えてあげるわ、アクア。@　私は、このメディウスであなたを殺す。@　ためらいなくね」",
   "en": "",
   "kind": "text",
   "keep": false
  },
  {
   "id": 412,
   "jp": "「先生、あなたと言う人は……！」",
